// cat.rig.jsonc — the whole cat, authored as data.
//
// A rig is three parts and a library of clips, split along one clean seam:
//   • bones        the abstract handles the animation moves (never drawn)
//   • skin         which drawn shape each bone deforms, and by how much
//   • clips        ATOMIC keyframe data — a TIME-DOMAIN motion in milliseconds
//                  (0 = rest through to the clip's authored duration) that knows
//                  nothing about clocks, cursors, or who samples it. A bone
//                  attribute over time, a procedural wave, a morph between shapes,
//                  or a paint tween.
//   • controllers  the live inputs, each PLACING clips on a coordinate: it reads
//                  its source value v and samples a placed clip at
//                  u = (v - offset) / scale. A controller is a pure lookup — it
//                  decides *where* a clip is read, never *what* the clip contains.
//
// Nothing here is code. The runtime reads this file, and the host (main.ts)
// only supplies the live inputs — the cursor, a click — as named controllers.
// Comments are for you and for the next author (human or agent); jsonc-parser
// strips them at load, so the evaluator never sees them.
{
  // The SVG this rig animates. Its <path> elements are the drawn shapes; ids in
  // the SVG (eyeR, eyeL, heartR, heartL, nose) are how channels name geometry.
  "svg": "cat.svg",

  // Bones: named handles with a rest position. A bone is a coordinate frame the
  // skeleton can translate/scale/rotate; the skin rides it. These x/y are the
  // eyes' and nose's resting centres, in SVG user units — every gaze extreme
  // below is just a few units off these.
  "bones": {
    "eyeR": { "x": 65.359, "y": 57.512 },
    "eyeL": { "x": 35.414, "y": 57.512 },
    "nose": { "x": 50.08,  "y": 61.06  }
  },

  // Skin: bone -> shape -> (point index | "*") -> weight.
  // The shape key is a path's draw-order index (a number) or its SVG id. "*"
  // weights every point of that shape; weights are normalised per point at bind.
  // Here each bone owns one shape wholesale: eyeR drives shape 0, eyeL shape 1,
  // nose drives the shape with id "nose".
  "skin": {
    "eyeR": { "0":    { "*": 1 } },
    "eyeL": { "1":    { "*": 1 } },
    "nose": { "nose": { "*": 1 } }
  },

  // Clips: the atomic library. Each is a time-domain motion in milliseconds — a
  // set of channels, one writing each slot (a bone attribute like eyeR.x, a
  // whole-shape geometry like eyeR, or a paint like eyeR.fill) over a parameter.
  // A clip's channels must write disjoint slots; a clip's "wrap" says what a
  // parameter past its span means (default "hold" = abstain, casting no vote off
  // its edge).
  "clips": {

    // sniff — a procedural channel, no keyframes. The nose's y rides a sine
    // whose centre (bias) is itself a slow noise wander, so the sniff never
    // repeats exactly. fn/bias/amp/freq are the generator's knobs; any knob may
    // be a constant or another wave, arbitrarily deep. A wave is born infinite:
    // it owns no span and reads the raw clock, so this clip plays as wall time.
    "sniff": {
      "channels": {
        "nose.y": {
          "fn": "sine",
          "bias": { "fn": "noise", "bias": 61.06, "amp": 0.3, "freq": 12 },
          "amp": 0.7,
          "freq": 1.2
        }
      }
    },

    // blink — a keyed clip that loops. "wrap": "loop" means a parameter past the
    // last key (2000 ms) folds back to the start, so the blink repeats forever.
    // Both eyelids squash together: sy (vertical scale) holds at 1, snaps to 0.08
    // for ~100 ms around t=1300, then reopens. Times are milliseconds — this clip
    // is read directly by the host at wall time (no controller places it).
    "blink": {
      "wrap": "loop",
      "channels": {
        "eyeR.sy": { "keys": { "0": 1, "1200": 1, "1300": 0.08, "1400": 1, "2000": 1 } },
        "eyeL.sy": { "keys": { "0": 1, "1200": 1, "1300": 0.08, "1400": 1, "2000": 1 } }
      }
    },

    // The four gaze clips. Each is a time-domain motion in milliseconds, from
    // rest (u=0, the eye's resting centre) to one full deflection (u=1000).
    // Default "hold" wrap means a parameter outside [0,1000] abstains — casts no
    // vote — which is exactly what lets two half-axis clips share one slot (see
    // gazeX/gazeY below). gazeLeft/Right move x only; gazeUp/Down move y only —
    // deliberately disjoint so the horizontal and vertical controllers never
    // fight over a slot.
    "gazeLeft":  { "channels": {
      "eyeR.x": { "keys": { "0": 65.359, "1000": 62.859 } },
      "eyeL.x": { "keys": { "0": 35.414, "1000": 32.914 } }
    } },
    "gazeRight": { "channels": {
      "eyeR.x": { "keys": { "0": 65.359, "1000": 67.859 } },
      "eyeL.x": { "keys": { "0": 35.414, "1000": 37.914 } }
    } },
    "gazeUp":    { "channels": {
      "eyeR.y": { "keys": { "0": 57.512, "1000": 54.712 } },
      "eyeL.y": { "keys": { "0": 57.512, "1000": 54.712 } }
    } },
    "gazeDown":  { "channels": {
      "eyeR.y": { "keys": { "0": 57.512, "1000": 60.312 } },
      "eyeL.y": { "keys": { "0": 57.512, "1000": 60.312 } }
    } },

    // bloom — eyes morph into hearts, then settle back. A time-domain clip in
    // milliseconds, exactly like `blink` above: the whole eye -> heart -> eye play
    // is authored to last 900 ms, with the heart held at its midpoint (450 ms). Its
    // timing lives HERE, in the clip — not in whoever plays it. "wrap": "clamp"
    // trims the ramp to a single play (holding the edge frames past 0 and 900 ms),
    // and the heartClock controller (below) just gates it on a click at offset 1.
    //
    // Four channels, each a keyed tween that departs eye -> heart -> eye:
    //   eyeR / eyeL          geometry slots — the SHAPE morphs (value names a
    //                        drawn shape: eyeR, heartR, ...), interpolated as paths
    //   eyeR.fill / eyeL.fill paint slots — the colour tweens black -> heart-red -> black
    //
    // Each key's "in"/"out" are Bézier handles shaping the tween: "out" how it
    // leaves this key toward the next, "in" how it arrives at the next. The
    // 0.42/0.58 handles give the classic ease-in-out so the bloom eases, holds
    // the heart at the 450 ms midpoint, and eases back.
    "bloom": {
      "wrap": "clamp",
      "channels": {
        "eyeR": { "keys": {
          "0":   { "value": "eyeR",   "out": [0.42, 0] },
          "450": { "value": "heartR", "in": [0.58, 1], "out": [0.42, 0] },
          "900": { "value": "eyeR",   "in": [0.58, 1] }
        } },
        "eyeL": { "keys": {
          "0":   { "value": "eyeL",   "out": [0.42, 0] },
          "450": { "value": "heartL", "in": [0.58, 1], "out": [0.42, 0] },
          "900": { "value": "eyeL",   "in": [0.58, 1] }
        } },
        "eyeR.fill": { "keys": {
          "0":   { "value": "#000000", "out": [0.42, 0] },
          "450": { "value": "#e6394a", "in": [0.58, 1], "out": [0.42, 0] },
          "900": { "value": "#000000", "in": [0.58, 1] }
        } },
        "eyeL.fill": { "keys": {
          "0":   { "value": "#000000", "out": [0.42, 0] },
          "450": { "value": "#e6394a", "in": [0.58, 1], "out": [0.42, 0] },
          "900": { "value": "#000000", "in": [0.58, 1] }
        } }
      }
    },

    // wander — idle eyes. Four saccade generators (the engine's hold-then-glide
    // random) ease the eyes to a fresh fixation, HOLD it, then flick to the next.
    // Each channel rests on its eye's centre (bias) and reaches the same ±2.5/2.8
    // the gaze clips do, so a wandering glance covers exactly the field a tracked
    // one would. Both eyes share a freq per axis, so they move TOGETHER (conjugate
    // gaze); x and y run at different rates (1.1 vs 0.8 Hz) so the fixations
    // scatter across the field instead of sliding along a diagonal. Like every
    // generator it owns no span and reads the raw clock — infinite idle motion.
    "wander": {
      "channels": {
        "eyeR.x": { "fn": "saccade", "bias": 65.359, "amp": 2.5, "freq": 1.1 },
        "eyeL.x": { "fn": "saccade", "bias": 35.414, "amp": 2.5, "freq": 1.1 },
        "eyeR.y": { "fn": "saccade", "bias": 57.512, "amp": 2.8, "freq": 0.8 },
        "eyeL.y": { "fn": "saccade", "bias": 57.512, "amp": 2.8, "freq": 0.8 }
      }
    }
  },

  // Controllers: the live inputs this rig expects, each PLACING clips on a
  // coordinate. Declaring them makes the rig self-describing — this file alone
  // says exactly what the host must feed it, so an editor can stand in stub
  // sliders. A controller reads its source value v (supplied by the host) and, for
  // each placement, samples the clip at u = (v - offset) / scale — "offset"
  // anchors the clip (the input where u=0) and "scale" is how many input units
  // span one clip ms, its sign mirroring the clip onto the other side.
  //   kind   — the runtime *currency*. "number" for a coordinate/clock. Written
  //            for completeness; the evaluator does not yet branch on it.
  //   editor — how the value is *authored* (the WinForms [Editor] model). Read by
  //            the inspector, never by the evaluator.
  //     as "coordinate" — swept along a ruler. range is that ruler; default = rest.
  //     as "clock"      — a time source scrubbed through a clip. gate "trigger"
  //                        means it abstains until fired (the click), so no default.
  //   clips  — the placements this controller folds. Each names a clip and the
  //            offset + scale that position it.
  // The host still supplies the actual t -> value closures (main.ts); this is the
  // signature, those are the bodies.
  "controllers": {

    // gazeX — the horizontal cursor coordinate in [-1, 1]. It places gazeLeft
    // scaled by -0.001 and gazeRight by +0.001 (each gaze clip runs 0…1000 ms, so
    // one coordinate unit spans the whole 1000 ms clip): at v=-1, gazeLeft reads
    // u=(-1)/(-0.001)=1000 (full left) while gazeRight reads u=-1000 and abstains
    // (hold past its edge); at v=0 both read u=0 (rest) and agree; at v=+0.5 only
    // gazeRight votes (u=500). Two half-axis clips resolve to one value by the
    // abstain + blend laws. The sign of `scale` is what mirrors each side.
    "gazeX": {
      "kind": "number",
      "editor": { "as": "coordinate", "range": [-1, 1], "default": 0 },
      "clips": [
        { "clip": "gazeLeft",  "offset": 0, "scale": -0.001 },
        { "clip": "gazeRight", "offset": 0, "scale":  0.001 }
      ]
    },

    // gazeY — the vertical cursor coordinate, the same construction over the y
    // slots: gazeUp at scale -0.001, gazeDown at +0.001. Because gazeX writes only
    // x and gazeY only y, the two fold in the host's mix with no weights at all.
    "gazeY": {
      "kind": "number",
      "editor": { "as": "coordinate", "range": [-1, 1], "default": 0 },
      "clips": [
        { "clip": "gazeUp",   "offset": 0, "scale": -0.001 },
        { "clip": "gazeDown", "offset": 0, "scale":  0.001 }
      ]
    },

    // heartClock — a clock that plays the bloom clip once per click. A clock's
    // input already IS time, so this is the identity placement (offset 0, scale
    // 1): the host's source returns the raw click-relative time (t - bloom) in ms,
    // sampled straight against the clip's ms keys (u = (t - 0) / 1). The clip owns
    // its own timing (a 900 ms play). Before the first click the source abstains
    // (undefined) and the controller casts no vote — the eyes rest and blink shows
    // through.
    "heartClock": {
      "kind": "number",
      "editor": { "as": "clock", "gate": "trigger" },
      "clips": [
        { "clip": "bloom", "offset": 0, "scale": 1 }
      ]
    },

    // lookBlend — a WEIGHTS controller, the `look` mix's `by`. It places no clips
    // of its own; it hands the mix one weight per input (wander/gazeX/gazeY). The
    // host eases those weights from all-wander to all-gaze as the pointer enters
    // and leaves the SVG. kind "weights" is the currency the evaluator checks, and
    // "as: weights" tells an editor to show a fader bank rather than a ruler.
    "lookBlend": {
      "kind": "weights",
      "editor": { "as": "weights" }
    }
  },

  // Mixes: the third node kind — a weighted fan-in of other nodes (clips,
  // controllers, or mixes), crossfaded by a controller that returns a WEIGHT MAP
  // (one weight per named input) instead of a coordinate. Where a controller
  // decides *where* a clip is read, a mix decides *how much* each node counts.
  "mixes": {

    // look — the eyes' single gaze node, blending idle wander against cursor
    // tracking. Its three inputs write overlapping slots: `wander` throws all four
    // eye channels, `gazeX` places the horizontal gaze clips, `gazeY` the vertical.
    // The `lookBlend` controller (host) returns { wander: 1-k, gazeX: k, gazeY: k },
    // so at k=0 the eyes wander freely and at k=1 they track the cursor — and per
    // slot the weights always total 1 (wander + whichever gaze axis owns it), so
    // the crossfade never divides by zero. The host eases k toward 1 while the
    // pointer is inside the SVG and back toward 0 when it leaves.
    "look": {
      "mix": ["wander", "gazeX", "gazeY"],
      "by": "lookBlend"
    }
  }
}
